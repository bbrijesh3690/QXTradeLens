{
  "manifest_version": 3,
  "name": "QXTradeLens Controller",
  "version": "1.54.0",
  "description": "Professional trading controls and real-time scaling for QXTradeLens.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1:7331/*",
    "http://127.0.0.1:7343/*",
    "*://qxbroker.com/*",
    "*://*.qxbroker.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "commands": {
    "dev-reload": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Dev: reload the extension and refresh open qxbroker tabs"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://qxbroker.com/*",
        "*://*.qxbroker.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://qxbroker.com/*",
        "*://*.qxbroker.com/*"
      ],
      "js": [
        "chart_reader.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "QXTradeLens Controls",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
